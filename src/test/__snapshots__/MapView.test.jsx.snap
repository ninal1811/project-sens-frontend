exports[`MapView Snapshots > matches snapshot with all components rendered 1`] = `
<div>
  <div
    class="mapview-root"
  >
    <div
      data-testid="navbar"
    >
      NavBar
    </div>
    <div
      data-show-states="false"
      data-testid="legend"
    >
      Legend
    </div>
    <div
      class="dietary-filter-bar"
    >
      <button
        class="dietary-filter-btn "
        title="Vegan"
      >
        <span>
          🥬
        </span>
        <span>
          Vegan
        </span>
      </button>
      <button
        class="dietary-filter-btn "
        title="Vegetarian"
      >
        <span>
          🌱
        </span>
        <span>
          Vegetarian
        </span>
      </button>
      <button
        class="dietary-filter-btn "
        title="Meat"
      >
        <span>
          🥩
        </span>
        <span>
          Meat
        </span>
      </button>
      <button
        class="dietary-filter-btn "
        title="Seafood"
      >
        <span>
          🐟
        </span>
        <span>
          Seafood
        </span>
      </button>
    </div>
    <div
      class="map-wrapper"
    >
      <div
        data-testid="map"
      >
        <div
          data-testid="tile-layer"
        />
        <div
          data-testid="geojson-layer"
        />
        <div
          data-testid="tile-layer"
        />
      </div>
    </div>
  </div>
</div>
`;

